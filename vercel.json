{
  "buildCommand": "pnpm build && pnpm build:vercel-api",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|favicon.ico|robots.txt|api/).*)",
      "destination": "/index.html"
    }
  ]
}
